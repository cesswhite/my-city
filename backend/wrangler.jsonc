{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-city-local",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-23",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "dev": { "ip": "127.0.0.1", "port": 8787, "local_protocol": "http" },
  "vars": { "OPENAI_MODEL": "gpt-6-luna" }
}
